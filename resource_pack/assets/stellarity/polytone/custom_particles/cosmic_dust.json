{
  "type": "custom",
  "initializer": {
    "lifetime": "80 + 40 * rand()",
    "alpha": "0.85",
    "size": "0.75 + 0.25 * rand()",
    "red": "0.85 + 0.1 * rand()",
    "green": "0.82 + 0.1 * rand()",
    "blue": "0.98",
    "roll": "rand() * 2 * pi"
  },
  "ticker": {
    "dy": "0.015",
    "dx": "0.005 * (rand() - 0.5)",
    "dz": "0.005 * (rand() - 0.5)",
    "alpha": "0.85 * sin((pi / LIFETIME) * AGE)",
    "size": "(0.65 + 0.25 * rand()) * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 32"
  },
  "lit": true,
  "light_level": 15,
  "render_type": "additive_translucent",
  "has_physics": false
}
