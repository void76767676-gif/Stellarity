{
  "type": "custom",
  "initializer": {
    "lifetime": "45 + 20 * rand()",
    "alpha": "0.1",
    "size": "0.95 + 0.25 * rand()",
    "roll": "rand() * 2 * pi"
  },
  "ticker": {
    "dy": "0.012 * (1 - AGE / LIFETIME)",
    "dx": "0.004 * cos(0.1 * AGE)",
    "dz": "0.004 * sin(0.1 * AGE)",
    "size": "SIZE + 0.006",
    "alpha": "0.65 * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 36"
  },
  "lit": true,
  "light_level": 15,
  "render_type": "additive_translucent",
  "has_physics": false
}
