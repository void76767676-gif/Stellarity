{
  "type": "custom",
  "initializer": {
    "lifetime": "60 + 30 * rand()",
    "alpha": "0.1",
    "size": "0",
    "custom": "rand() * 0.3",
    "dx": "0.015 * (rand() - 0.5)",
    "dy": "0.01 + 0.01 * rand()",
    "dz": "0.015 * (rand() - 0.5)",
    "hitbox_size": 0.25
  },
  "ticker": {
    "dx": "DX",
    "dy": "DY",
    "dz": "DZ",
    "size": "(0.55 + CUSTOM) * sin((pi / LIFETIME) * AGE)",
    "alpha": "0.9 * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 36"
  },
  "lit": true,
  "light_level": 15,
  "render_type": "additive_translucent",
  "has_physics": false
}
