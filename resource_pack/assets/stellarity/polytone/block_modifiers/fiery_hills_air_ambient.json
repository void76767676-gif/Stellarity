      "dy": "0.012 + r.rand() * 0.01",
      "dz": "(r.rand() - 0.5) * 0.01"
    },
    {
      "particle": "minecraft:smoke",
      "chance": "0.001 * (biome() == \"stellarity:fiery_hills\") * (DISTANCE_SQUARED < 400)",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.008",
      "dy": "0.015 + r.rand() * 0.01",
      "dz": "(r.rand() - 0.5) * 0.008"
    }
  ]
