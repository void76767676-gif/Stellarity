{
  "targets": [
    "minecraft:air"
  ],
  "particle_emitters": [
    {
      "particle": "minecraft:small_flame",
      "chance": "0.0012 * (biome() == \"stellarity:fiery_hills\") * (DISTANCE_SQUARED < 400)",
      "x": "r.rand()",
