{
  "targets": [
    "minecraft:air"
  ],
  "particle_emitters": [
    {
      "particle": "minecraft:portal",
      "chance": "0.001 * (DISTANCE_SQUARED < 400)",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.015",
      "dy": "(r.rand() - 0.5) * 0.015",
      "dz": "(r.rand() - 0.5) * 0.015",
      "biomes": [
        "stellarity:end_wilds",
        "stellarity:end_shrubland",
        "stellarity:ender_wastes"
      ]
    },
    {
      "particle": "minecraft:reverse_portal",
      "chance": "0.0005 * (DISTANCE_SQUARED < 400)",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.01",
      "dy": "0.008 + r.rand() * 0.008",
      "dz": "(r.rand() - 0.5) * 0.01",
      "biomes": [
        "stellarity:end_wilds",
        "stellarity:end_shrubland",
        "stellarity:ender_wastes"
      ]
    }
  ]
}