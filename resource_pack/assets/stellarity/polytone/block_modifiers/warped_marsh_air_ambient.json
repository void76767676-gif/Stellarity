{
  "targets": [
    "minecraft:air"
  ],
  "particle_emitters": [
    {
      "particle": "minecraft:warped_spore",
      "chance": "0.003 * (biome() == \"stellarity:warped_marsh\") * (DISTANCE_SQUARED < 625)",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.008",
      "dy": "-0.004 - r.rand() * 0.004",
      "dz": "(r.rand() - 0.5) * 0.008"
    },
    {
      "particle": "minecraft:spore_blossom_air",
      "chance": "0.001 * (biome() == \"stellarity:warped_marsh\") * (DISTANCE_SQUARED < 400)",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.006",
      "dy": "0.002 + r.rand() * 0.004",
      "dz": "(r.rand() - 0.5) * 0.006"
    }
  ]
}