{
  "targets": [
    "minecraft:cherry_leaves",
    "minecraft:pink_petals",
    "minecraft:grass_block"
  ],
  "particle_emitters": [
    {
      "particle": "minecraft:cherry_leaves",
      "chance": "0.035 * (biome() == 'stellarity:the_hallow') * (DISTANCE_SQUARED < 900)",
      "x": "(r.rand() - 0.5) * 0.9",
      "y": "(r.rand() - 0.5) * 0.9",
      "z": "(r.rand() - 0.5) * 0.9",
      "dy": "-0.01 - r.rand() * 0.01"
    },
    {
      "particle": "minecraft:end_rod",
      "chance": "0.012 * (biome() == 'stellarity:the_hallow') * (DISTANCE_SQUARED < 625)",
      "x": "(r.rand() - 0.5) * 0.8",
      "y": "(r.rand() - 0.5) * 0.8",
      "z": "(r.rand() - 0.5) * 0.8",
      "dy": "0.015 + r.rand() * 0.01"
    }
  ]
}
