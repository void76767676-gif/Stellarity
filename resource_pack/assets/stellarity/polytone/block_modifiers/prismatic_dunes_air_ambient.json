    },
    {
      "particle": "minecraft:glow",
      "chance": "0.001 * (POS_Y > 50) * (DISTANCE_SQUARED < 300) * (biome() == 'stellarity:prismatic_dunes')",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "0.0",
