{
  "targets": [
    "minecraft:air"
  ],
  "particle_emitters": [
    {
      "particle": "minecraft:flame",
      "chance": "0.0008 * (POS_Y > 50) * (DISTANCE_SQUARED < 300) * (biome() == 'stellarity:blazing_dunes')",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.005",
      "dy": "0.012 + r.rand() * 0.01",
      "dz": "(r.rand() - 0.5) * 0.005"
    },
    {
      "particle": "minecraft:ash",
      "chance": "0.002 * (POS_Y > 50) * (DISTANCE_SQUARED < 400) * (biome() == 'stellarity:blazing_dunes')",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.01",
      "dy": "-0.01 - r.rand() * 0.005",
      "dz": "(r.rand() - 0.5) * 0.01"
    }
  ]
}
