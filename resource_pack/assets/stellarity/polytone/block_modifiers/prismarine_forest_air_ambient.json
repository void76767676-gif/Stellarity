      "z": "r.rand()",
      "dx": "0.0",
      "dy": "0.008 + r.rand() * 0.006",
      "dz": "0.0"
    },
    {
      "particle": "minecraft:underwater",
      "chance": "0.001 * (POS_Y > 50) * (DISTANCE_SQUARED < 300) * (biome() == 'stellarity:prismarine_forest')",
      "x": "r.rand()",
      "y": "r.rand()",
      "z": "r.rand()",
      "dx": "(r.rand() - 0.5) * 0.008",
      "dy": "0.012",
      "dz": "(r.rand() - 0.5) * 0.008"
    }
  ]
}
