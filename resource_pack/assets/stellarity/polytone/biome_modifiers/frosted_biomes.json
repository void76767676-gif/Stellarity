{
  "targets": ".*:(frosted|frozen).*",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : 'a8dadc'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '0b132b'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.30",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.86"
    }
  }
}