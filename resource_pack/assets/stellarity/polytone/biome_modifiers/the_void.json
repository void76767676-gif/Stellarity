{
  "targets": ".*:the_void",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#000000",
      "minecraft:visual/sky_color": "#000000",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() < 55 ? 0.05 : 0.16)",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() < 55 ? 0.45 : 0.70)"
    }
  }
}