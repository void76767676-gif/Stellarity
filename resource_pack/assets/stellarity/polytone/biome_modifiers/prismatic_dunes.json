{
  "targets": ".*:prismatic_dunes",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#e8b4f8",
      "minecraft:visual/sky_color": "#48cae4",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.48 : (c.y() < 60 ? 0.14 : 0.36))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.98 : (c.y() < 60 ? 0.66 : 0.90))"
    }
  }
}