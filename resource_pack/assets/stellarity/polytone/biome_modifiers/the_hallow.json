{
  "targets": ".*:the_hallow",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : 'f6b0d2'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '48cae4'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * (0.38 + clamp((c.y() - 130) / 300.0, 0.0, 0.25))",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * (0.88 + clamp((c.y() - 130) / 350.0, 0.0, 0.10))"
    }
  }
}
