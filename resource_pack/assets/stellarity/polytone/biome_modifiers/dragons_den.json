{
  "targets": ".*:dragons_den",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#4a154b",
      "minecraft:visual/sky_color": "#1f0426",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.40 : (c.y() < 60 ? 0.08 : 0.22))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.92 : (c.y() < 60 ? 0.58 : 0.82))"
    }
  }
}