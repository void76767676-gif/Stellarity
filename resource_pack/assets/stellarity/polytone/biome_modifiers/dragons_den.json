          }
        }
      },
      "minecraft:visual/ambient_particles": {
        "modifier": "override",
        "argument": [
          {
            "particle": {
              "type": "minecraft:dragon_breath"
            },
            "probability": 0.0012
          }
        ]
      }
    }
  }
}