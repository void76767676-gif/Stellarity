{
  "targets": ".*:crystal_crags",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#b8a9c9",
      "minecraft:visual/sky_color": "#3a2052",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.48 : (c.y() < 60 ? 0.14 : 0.35))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.98 : (c.y() < 60 ? 0.66 : 0.90))"
    }
  }
}