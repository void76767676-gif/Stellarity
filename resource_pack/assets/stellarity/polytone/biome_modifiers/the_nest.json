{
  "targets": ".*:the_nest",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#483434",
      "minecraft:visual/sky_color": "#1c1212",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.42 : (c.y() < 60 ? 0.08 : 0.25))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.92 : (c.y() < 60 ? 0.58 : 0.82))"
    }
  }
}