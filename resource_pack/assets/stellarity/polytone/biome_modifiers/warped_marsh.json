{
  "targets": ".*:warped_marsh",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : '16c79a'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '0b2545'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.28",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.82"
    }
  }
}