{
  "targets": ".*:warped_marsh",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#16c79a",
      "minecraft:visual/sky_color": "#0f3057",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.38 : (c.y() < 60 ? 0.08 : 0.22))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.90 : (c.y() < 60 ? 0.58 : 0.80))"
    }
  }
}