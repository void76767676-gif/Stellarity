{
  "targets": ".*:amethyst_forest",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#9d4edd",
      "minecraft:visual/sky_color": "#240046",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 165 ? 0.48 : (c.y() < 60 ? 0.15 : 0.36))",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 165 ? 0.98 : (c.y() < 60 ? 0.68 : 0.90))"
    }
  }
}