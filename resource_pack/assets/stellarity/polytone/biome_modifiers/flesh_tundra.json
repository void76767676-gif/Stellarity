{
  "targets": ".*:flesh_tundra",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : '8a1c36'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '1e0009'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.25",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.80"
    }
  }
}