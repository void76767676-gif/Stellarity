{
  "targets": ".*:endless_dunes",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : 'e0a96d'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '201a30'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.40",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.94"
    }
  }
}