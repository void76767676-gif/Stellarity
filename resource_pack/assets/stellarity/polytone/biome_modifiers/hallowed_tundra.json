{
  "targets": ".*:hallowed_tundra",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : 'd8e2dc'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '1d2238'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.38",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.92"
    }
  }
}