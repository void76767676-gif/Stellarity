{
  "targets": ".*:ashfall_deltas",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "c.y() < -1 ? '000000' : '5c5470'",
      "minecraft:visual/sky_color": "c.y() < -1 ? '000000' : '1a1a24'",
      "minecraft:visual/fog_start_distance": "c.y() < -1 ? 0.0 : c.viewDistance() * 0.22",
      "minecraft:visual/fog_end_distance": "c.y() < -1 ? 14.0 : c.viewDistance() * 0.78"
    }
  }
}