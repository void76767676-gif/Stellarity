{
  "targets": ".*:(the_end|end_highlands|end_midlands|small_end_islands|end_barrens)",
  "attributes_modifiers": {
    "base": {
      "minecraft:visual/fog_color": "#2c1654",
      "minecraft:visual/sky_color": "#120824",
      "minecraft:visual/fog_start_distance": "c.viewDistance() * (c.y() > 170 ? 0.45 : 0.35)",
      "minecraft:visual/fog_end_distance": "c.viewDistance() * (c.y() > 170 ? 0.95 : 0.88)"
    }
  }
}